generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

enum InventoryChangeType {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
}

enum CreditEntryType {
  SALE_ON_CREDIT
  PAYMENT_RECEIVED
  ADJUSTMENT
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  CREDIT_OVERDUE
  NEW_SALE
  SYSTEM
}

// ---------------- Tenant / Platform ----------------

model Business {
  id           String   @id @default(uuid())
  name         String
  industryType String?
  size         String?
  location     String?
  gstNumber    String?
  currency     String   @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  categories   Category[]
  products     Product[]
  customers    Customer[]
  suppliers    Supplier[]
  sales        Sale[]
  purchases    Purchase[]
  expenses     Expense[]
  inventoryLedger InventoryLedger[]
  auditLogs    AuditLog[]
  reorderSuggestions ReorderSuggestion[]
  healthScores BusinessHealthScore[]
  creditLedgerEntries CreditLedgerEntry[]
  notifications Notification[]
}

model User {
  id           String   @id @default(uuid())
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ---------------- Catalog / Inventory ----------------

model Category {
  id         String    @id @default(uuid())
  business   Business  @relation(fields: [businessId], references: [id])
  businessId String
  name       String
  products   Product[]
  createdAt  DateTime  @default(now())
}

model Product {
  id             String   @id @default(uuid())
  business       Business @relation(fields: [businessId], references: [id])
  businessId     String
  name           String
  sku            String?
  barcode        String?
  category       Category? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  purchasePrice  Decimal  @db.Decimal(12, 2)
  sellingPrice   Decimal  @db.Decimal(12, 2)
  gstRatePercent Decimal  @db.Decimal(5, 2) @default(0)
  stockQuantity  Int      @default(0)
  minimumStock   Int      @default(0)
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  supplierId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  inventoryLedger InventoryLedger[]
  reorderSuggestions ReorderSuggestion[]

  @@index([businessId])
}

model InventoryLedger {
  id             String               @id @default(uuid())
  business       Business             @relation(fields: [businessId], references: [id])
  businessId     String
  product        Product              @relation(fields: [productId], references: [id])
  productId      String
  changeType     InventoryChangeType
  quantityDelta  Int
  resultingStock Int
  referenceId    String?
  note           String?
  createdAt      DateTime             @default(now())

  @@index([businessId, productId])
}

// ---------------- Customers / Suppliers ----------------

model Customer {
  id            String   @id @default(uuid())
  business      Business @relation(fields: [businessId], references: [id])
  businessId    String
  name          String
  phone         String?
  email         String?
  address       String?
  totalSpent    Decimal  @db.Decimal(12, 2) @default(0)
  creditLimit   Decimal  @db.Decimal(12, 2) @default(0)
  outstandingCredit Decimal @db.Decimal(12, 2) @default(0)
  lastPurchaseAt DateTime?
  createdAt     DateTime @default(now())

  sales         Sale[]
  creditLedgerEntries CreditLedgerEntry[]
}

model Supplier {
  id             String   @id @default(uuid())
  business       Business @relation(fields: [businessId], references: [id])
  businessId     String
  name           String
  phone          String?
  email          String?
  avgDeliveryDays Int?    @default(7)
  rating         Decimal? @db.Decimal(3, 2)
  createdAt      DateTime @default(now())

  products       Product[]
  purchases      Purchase[]
}

// ---------------- Sales ----------------

model Sale {
  id            String        @id @default(uuid())
  business      Business      @relation(fields: [businessId], references: [id])
  businessId    String
  invoiceNumber String
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerId    String?
  subtotal      Decimal       @db.Decimal(12, 2)
  gstAmount     Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PAID)
  saleDate      DateTime      @default(now())
  createdAt     DateTime      @default(now())

  items         SaleItem[]

  @@index([businessId, saleDate])
}

model SaleItem {
  id         String  @id @default(uuid())
  sale       Sale    @relation(fields: [saleId], references: [id])
  saleId     String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  gstRatePercent Decimal @db.Decimal(5, 2) @default(0)
  subtotal   Decimal @db.Decimal(12, 2)
}

// ---------------- Purchases ----------------

model Purchase {
  id           String         @id @default(uuid())
  business     Business       @relation(fields: [businessId], references: [id])
  businessId   String
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  supplierId   String?
  poNumber     String
  totalAmount  Decimal        @db.Decimal(12, 2)
  status       PurchaseStatus @default(ORDERED)
  purchaseDate DateTime       @default(now())
  createdAt    DateTime       @default(now())

  items        PurchaseItem[]

  @@index([businessId, purchaseDate])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
}

// ---------------- Expenses ----------------

model Expense {
  id         String   @id @default(uuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  category   String
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  expenseDate DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([businessId, expenseDate])
}

// ---------------- Intelligence ----------------

model ReorderSuggestion {
  id                String   @id @default(uuid())
  business          Business @relation(fields: [businessId], references: [id])
  businessId        String
  product           Product  @relation(fields: [productId], references: [id])
  productId         String
  currentStock      Int
  avgDailySales     Decimal  @db.Decimal(10, 2)
  leadTimeDays      Int
  reorderPoint      Int
  recommendedQty    Int
  generatedAt       DateTime @default(now())
}

model BusinessHealthScore {
  id               String   @id @default(uuid())
  business         Business @relation(fields: [businessId], references: [id])
  businessId       String
  score            Int
  revenueGrowth    Decimal  @db.Decimal(6, 2)
  profitMargin     Decimal  @db.Decimal(6, 2)
  inventoryEfficiency Decimal @db.Decimal(6, 2)
  expenseControl   Decimal  @db.Decimal(6, 2)
  computedAt       DateTime @default(now())
}

// ---------------- Credit Ledger ----------------
// Tracks "udhaar" (credit) given to customers and payments received against it.
// outstandingCredit on Customer is a cached running balance for fast reads;
// this table is the source of truth / audit trail.

model CreditLedgerEntry {
  id            String          @id @default(uuid())
  business      Business        @relation(fields: [businessId], references: [id])
  businessId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  customerId    String
  type          CreditEntryType
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  referenceId   String?         // e.g. linked Sale id for SALE_ON_CREDIT
  note          String?
  createdAt     DateTime        @default(now())

  @@index([businessId, customerId])
}

// ---------------- Notifications ----------------

model Notification {
  id         String           @id @default(uuid())
  business   Business         @relation(fields: [businessId], references: [id])
  businessId String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  referenceId String?
  createdAt  DateTime         @default(now())

  @@index([businessId, isRead])
}
